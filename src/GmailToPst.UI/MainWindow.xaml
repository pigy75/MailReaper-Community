<Window x:Class="GmailToPst.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:models="clr-namespace:GmailToPst.Core.Models;assembly=GmailToPst.Core"
        xmlns:conv="clr-namespace:GmailToPst.UI.Converters"
        mc:Ignorable="d"
        Title="MailReaper - Enterprise Mail &amp; Workspace Extractor (PST / MSG / EML)" 
        Icon="assets/mailreaper.ico"
        Height="800" Width="1280"
        MinHeight="600" MinWidth="950"
        WindowStartupLocation="CenterScreen"
        Background="#F3F4F6">

    <Window.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis"/>
        <conv:BoolToVisibilityConverter x:Key="InverseBoolToVis" Invert="True"/>
        <conv:NullToVisibilityConverter x:Key="NullToVis"/>

        <!-- Stili per pulsanti della toolbar -->
        <Style x:Key="ToolbarButtonStyle" TargetType="Button">
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
        </Style>

        <!-- Template per Account (nodo principale nell'albero) -->
        <HierarchicalDataTemplate DataType="{x:Type models:AccountNode}" ItemsSource="{Binding Folders}">
            <StackPanel Orientation="Vertical" Margin="0,3">
                <StackPanel.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="🔄 Sincronizza / Scarica Nuovi Messaggi" Click="SyncAccount_Click"/>
                        <MenuItem Header="📊 Analizza Volumi per Anno..." Click="AnalyzeAccount_Click"/>
                        <Separator/>
                        <MenuItem Header="🗑️ Elimina Account e Dati Locali..." Click="DeleteAccount_Click" Foreground="#DC2626"/>
                    </ContextMenu>
                </StackPanel.ContextMenu>
                
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="📬 " FontSize="13" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding DisplayName}" FontWeight="Bold" FontSize="13" Foreground="#111827" VerticalAlignment="Center"/>
                    <Border Background="#DBEAFE" CornerRadius="10" Padding="6,1" Margin="8,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding FormattedTotalSize}" FontSize="11" Foreground="#1E40AF" FontWeight="SemiBold"/>
                    </Border>
                    <!-- Indicatore Sincronizzazione in corso -->
                    <Border Background="#FEF3C7" CornerRadius="6" Padding="6,1" Margin="6,0,0,0" VerticalAlignment="Center" Visibility="{Binding IsSyncing, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="⚡ Sincro..." Foreground="#92400E" FontSize="10" FontWeight="Bold"/>
                    </Border>
                </StackPanel>

                <!-- Barra di progresso individuale durante la sincronizzazione -->
                <StackPanel Margin="22,3,0,0" Visibility="{Binding IsSyncing, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="{Binding SyncStatusText}" FontSize="10" Foreground="#6B7280" TextTrimming="CharacterEllipsis"/>
                    <ProgressBar Value="{Binding SyncProgressPercent}" Height="3" Maximum="100" Margin="0,2,0,0"/>
                </StackPanel>
            </StackPanel>
        </HierarchicalDataTemplate>

        <!-- Template per l'albero delle cartelle di ogni Account -->
        <HierarchicalDataTemplate DataType="{x:Type models:EmailFolder}" ItemsSource="{Binding SubFolders}">
            <StackPanel Orientation="Horizontal" Margin="0,2">
                <TextBlock Text="📁 " FontSize="12" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding Name}" FontWeight="Medium" FontSize="12" Foreground="#374151" VerticalAlignment="Center"/>
                <Border Background="#F3F4F6" CornerRadius="10" Padding="5,1" Margin="6,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding TotalCount}" FontSize="11" Foreground="#6B7280" FontWeight="SemiBold"/>
                </Border>
            </StackPanel>
        </HierarchicalDataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Main Menu Bar -->
            <RowDefinition Height="Auto"/> <!-- Top Toolbar -->
            <RowDefinition Height="Auto"/> <!-- Progress Banner -->
            <RowDefinition Height="*"/>    <!-- 3-Pane Body -->
            <RowDefinition Height="Auto"/> <!-- Status Bar -->
        </Grid.RowDefinitions>

        <!-- 0. STANDARD MAIN MENU BAR -->
        <Menu Grid.Row="0" Background="#F3F4F6" BorderBrush="#E5E7EB" BorderThickness="0,0,0,1" Padding="4,2" FontSize="12">
            <MenuItem Header="_File">
                <MenuItem Header="➕ _Nuovo Backup &amp; Download..." InputGestureText="Ctrl+N" Click="NewBackup_Click"/>
                <MenuItem Header="💾 _Esporta Archivio (PST / MSG / EML)..." InputGestureText="Ctrl+E" Click="Export_Click"/>
                <MenuItem Header="📎 _Estrai Tutti gli Allegati &amp; Immagini..." InputGestureText="Ctrl+A" Command="{Binding ExtractAllAttachmentsCommand}"/>
                <Separator/>
                <MenuItem Header="⚙️ _Impostazioni Cartelle di Salvataggio..." InputGestureText="Ctrl+P" Command="{Binding OpenSettingsCommand}"/>
                <Separator/>
                <MenuItem Header="_Esci" InputGestureText="Alt+F4" Click="Exit_Click"/>
            </MenuItem>
            <MenuItem Header="_Modifica">
                <MenuItem Header="🔍 _Cerca nell'archivio..." InputGestureText="Ctrl+F" Command="{Binding SearchMessagesCommand}"/>
            </MenuItem>
            <MenuItem Header="_Visualizza">
                <MenuItem Header="🔄 _Aggiorna Cartelle &amp; Archivio" InputGestureText="F5" Command="{Binding RefreshFoldersCommand}"/>
                <Separator/>
                <MenuItem Header="📂 _Apri Cartella Archivio Database sul Disco" Command="{Binding OpenArchivesFolderCommand}"/>
            </MenuItem>
            <MenuItem Header="_Strumenti">
                <MenuItem Header="👤 _Gestione Account e Profili..." Click="NewBackup_Click"/>
                <MenuItem Header="🗑️ _Elimina Anno Selezionato..." Command="{Binding DeleteSelectedYearCommand}"/>
                <Separator/>
                <MenuItem Header="⚙️ _Opzioni e Percorsi Cartelle..." Command="{Binding OpenSettingsCommand}"/>
            </MenuItem>
            <MenuItem Header="_Aiuto">
                <MenuItem Header="🔑 _Licenza &amp; Attivazione PRO..." Click="License_Click"/>
                <Separator/>
                <MenuItem Header="ℹ️ _Informazioni su MailReaper" Command="{Binding ShowAboutCommand}"/>
            </MenuItem>
        </Menu>

        <!-- 1. TOP TOOLBAR -->
        <Border Grid.Row="1" Background="White" BorderBrush="#E5E7EB" BorderThickness="0,0,0,1" Padding="16,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Logo, Info Account e Dimensione Totale -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Source="assets/mailreaper.png" Width="32" Height="32" Margin="0,0,10,0" VerticalAlignment="Center"/>
                    <StackPanel VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="MailReaper" FontSize="16" FontWeight="ExtraBold" Foreground="#111827"/>
                            <Border Background="#DCFCE7" CornerRadius="4" Padding="6,1" Margin="8,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding FormattedTotalSize, StringFormat='💾 {0}'}" FontSize="11" Foreground="#166534" FontWeight="SemiBold"/>
                            </Border>
                        </StackPanel>
                        <TextBlock Text="{Binding CurrentAccountEmail}" FontSize="12" Foreground="#6B7280" Margin="0,2,0,0"/>
                    </StackPanel>

                    <!-- Selettore Anno Visualizzato ed Eliminazione -->
                    <Border Background="#F9FAFB" BorderBrush="#D1D5DB" BorderThickness="1" CornerRadius="6" Padding="6,2" Margin="16,0,0,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📅 Anno:" FontWeight="SemiBold" FontSize="12" Foreground="#4B5563" VerticalAlignment="Center" Margin="4,0,6,0"/>
                            <ComboBox ItemsSource="{Binding AvailableArchiveYears}" SelectedItem="{Binding SelectedArchiveYearFilter}" Height="28" Width="120" VerticalContentAlignment="Center" FontSize="12" BorderThickness="0" Background="Transparent"/>
                            <Button Content="🗑️" ToolTip="Elimina tutti i dati e le email dell'anno selezionato dall'archivio locale" Width="26" Height="26" Margin="4,0,2,0" Background="#FEE2E2" Foreground="#DC2626" BorderThickness="0" Command="{Binding DeleteSelectedYearCommand}" Visibility="{Binding HasSelectedSpecificYear, Converter={StaticResource BoolToVis}}" Cursor="Hand"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Search Bar Centrale -->
                <Border Grid.Column="1" HorizontalAlignment="Center" Width="320" Background="#F9FAFB" BorderBrush="#D1D5DB" BorderThickness="1" CornerRadius="6" Padding="6,2">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="🔍" VerticalAlignment="Center" Margin="4,0,6,0" Foreground="#9CA3AF"/>
                        <TextBox Grid.Column="1" Text="{Binding SearchKeyword, UpdateSourceTrigger=PropertyChanged}" BorderThickness="0" Background="Transparent" VerticalContentAlignment="Center" FontSize="12">
                            <TextBox.InputBindings>
                                <KeyBinding Key="Enter" Command="{Binding SearchMessagesCommand}"/>
                            </TextBox.InputBindings>
                        </TextBox>
                        <Button Grid.Column="2" Content="Cerca" Background="#E5E7EB" BorderThickness="0" Padding="8,3" FontSize="11" Command="{Binding SearchMessagesCommand}" Cursor="Hand"/>
                    </Grid>
                </Border>

                <!-- Pulsanti Azione Toolbar -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="➕ Nuovo Backup..." Style="{StaticResource ToolbarButtonStyle}" Background="#2563EB" Foreground="White" Click="NewBackup_Click"/>
                    <Button Content="📎 Estrai Allegati..." Style="{StaticResource ToolbarButtonStyle}" Background="#8B5CF6" Foreground="White" Command="{Binding ExtractAllAttachmentsCommand}"/>
                    <Button Content="💾 Esporta (PST/MSG)..." Style="{StaticResource ToolbarButtonStyle}" Background="#10B981" Foreground="White" Click="Export_Click"/>
                    <Button Content="🔄 Aggiorna" Style="{StaticResource ToolbarButtonStyle}" Background="#F3F4F6" Foreground="#374151" BorderThickness="1" BorderBrush="#D1D5DB" Command="{Binding RefreshFoldersCommand}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 2. PROGRESS BANNER (Durante download backup / estrazione) -->
        <Border Grid.Row="2" Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="0,0,0,1" Padding="14,10"
                Visibility="{Binding IsPerformingBackup, Converter={StaticResource BoolToVis}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <TextBlock Text="⏳ "/>
                        <TextBlock Text="{Binding BackupStatusText}" FontWeight="SemiBold" FontSize="12" Foreground="#1E40AF"/>
                        <TextBlock Text="{Binding BackupBytesText}" FontSize="12" Foreground="#3B82F6" Margin="10,0,0,0"/>
                    </StackPanel>
                    <ProgressBar Value="{Binding BackupProgressPercent}" Maximum="100" Height="6" Background="#DBEAFE" Foreground="#2563EB"/>
                </StackPanel>
                <Button Grid.Column="1" Content="Annulla" Background="#EF4444" Foreground="White" FontWeight="SemiBold" Padding="12,4" BorderThickness="0" Margin="15,0,0,0" VerticalAlignment="Center" Command="{Binding CancelBackupCommand}" Cursor="Hand"/>
            </Grid>
        </Border>

        <!-- 3. THREE-PANE BODY -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260" MinWidth="180"/> <!-- Left: Folders -->
                <ColumnDefinition Width="3"/>                  <!-- Splitter -->
                <ColumnDefinition Width="420" MinWidth="250"/> <!-- Center: Messages List -->
                <ColumnDefinition Width="3"/>                  <!-- Splitter -->
                <ColumnDefinition Width="*" MinWidth="300"/>   <!-- Right: Preview -->
            </Grid.ColumnDefinitions>

            <!-- LEFT PANE: ALBERO CARTELLE -->
            <Border Grid.Column="0" Background="White" BorderBrush="#E5E7EB" BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Padding="14,10" Background="#F9FAFB" BorderBrush="#E5E7EB" BorderThickness="0,0,0,1">
                        <TextBlock Text="ACCOUNT &amp; CARTELLE" FontWeight="Bold" FontSize="11" Foreground="#6B7280"/>
                    </Border>

                    <TreeView Grid.Row="1" ItemsSource="{Binding Accounts}" SelectedItemChanged="TreeView_SelectedItemChanged" BorderThickness="0" Background="Transparent" Padding="6">
                        <TreeView.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="💾 Esporta questa cartella in PST / MSG..." Click="ExportSelectedFolder_Click"/>
                                <MenuItem Header="📎 Estrai allegati &amp; immagini..." Command="{Binding ExtractAllAttachmentsCommand}"/>
                                <MenuItem Header="🔄 Ricarica account e cartelle" Command="{Binding RefreshFoldersCommand}"/>
                            </ContextMenu>
                        </TreeView.ContextMenu>
                    </TreeView>
                </Grid>
            </Border>

            <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" Background="#E5E7EB"/>

            <!-- CENTER PANE: LISTA MESSAGGI -->
            <Border Grid.Column="2" Background="White" BorderBrush="#E5E7EB" BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Intestazione Lista Messaggi -->
                    <Border Grid.Row="0" Padding="14,10" Background="#F9FAFB" BorderBrush="#E5E7EB" BorderThickness="0,0,0,1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{Binding SelectedFolder.Name, FallbackValue='Seleziona una cartella'}" FontWeight="Bold" FontSize="13" Foreground="#111827"/>
                            <TextBlock Grid.Column="1" Text="{Binding CurrentMessages.Count, StringFormat='{}{0} messaggi'}" FontSize="12" Foreground="#6B7280"/>
                        </Grid>
                    </Border>

                    <!-- Lista Messaggi (ListView) -->
                    <ListView Grid.Row="1" ItemsSource="{Binding CurrentMessages}" SelectedItem="{Binding SelectedMessage}" BorderThickness="0" Background="Transparent">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="#F3F4F6" BorderThickness="0,0,0,1" Padding="10,8">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Mittente -->
                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding DisplaySender}" FontWeight="SemiBold" FontSize="13" Foreground="#1F2937" TextTrimming="CharacterEllipsis"/>
                                        
                                        <!-- Data e icona allegato -->
                                        <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal">
                                            <TextBlock Text="📎" FontSize="11" Margin="0,0,4,0" Visibility="{Binding HasAttachments, Converter={StaticResource BoolToVis}}"/>
                                            <TextBlock Text="{Binding FormattedDate}" FontSize="11" Foreground="#9CA3AF"/>
                                        </StackPanel>

                                        <!-- Oggetto -->
                                        <TextBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Text="{Binding Subject}" FontSize="12" Foreground="#4B5563" TextTrimming="CharacterEllipsis" Margin="0,3,0,0"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Border>

            <GridSplitter Grid.Column="3" HorizontalAlignment="Stretch" Background="#E5E7EB"/>

            <!-- RIGHT PANE: ANTEPRIMA EMAIL & ALLEGATI -->
            <Border Grid.Column="4" Background="White">
                <!-- Se nessun messaggio è selezionato -->
                <Grid>
                    <TextBlock Text="Seleziona un'email per visualizzarne il contenuto" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#9CA3AF" FontSize="14"
                               Visibility="{Binding CurrentMessageDetails, Converter={StaticResource NullToVis}, ConverterParameter=invert}"/>

                    <!-- Anteprima del messaggio -->
                    <Grid Visibility="{Binding CurrentMessageDetails, Converter={StaticResource NullToVis}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/> <!-- Header card -->
                            <RowDefinition Height="Auto"/> <!-- Attachments -->
                            <RowDefinition Height="*"/>    <!-- Body Content -->
                        </Grid.RowDefinitions>

                        <!-- Header card -->
                        <Border Grid.Row="0" Padding="16,14" Background="#FAFAFA" BorderBrush="#E5E7EB" BorderThickness="0,0,0,1">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding CurrentMessageDetails.Subject}" FontSize="16" FontWeight="Bold" Foreground="#111827" TextWrapping="Wrap"/>
                                    <Button Grid.Column="1" Content="Apri file .EML" Padding="8,4" FontSize="11" Background="#E5E7EB" BorderThickness="0" Command="{Binding OpenRawEmlFileCommand}" Cursor="Hand" ToolTip="Apri con client predefinito"/>
                                </Grid>

                                <Grid Margin="0,10,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Da: " FontWeight="SemiBold" FontSize="12" Foreground="#6B7280"/>
                                    <TextBlock Grid.Column="1" Text="{Binding CurrentMessageDetails.DisplaySender}" FontSize="12" Foreground="#1F2937"/>
                                </Grid>

                                <Grid Margin="0,4,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="A: " FontWeight="SemiBold" FontSize="12" Foreground="#6B7280"/>
                                    <TextBlock Grid.Column="1" Text="{Binding CurrentMessageDetails.To}" FontSize="12" Foreground="#1F2937" TextTrimming="CharacterEllipsis"/>
                                </Grid>

                                <Grid Margin="0,4,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Data: " FontWeight="SemiBold" FontSize="12" Foreground="#6B7280"/>
                                    <TextBlock Grid.Column="1" Text="{Binding CurrentMessageDetails.FormattedDate}" FontSize="12" Foreground="#4B5563"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Striscia Allegati (se presenti) -->
                        <Border Grid.Row="1" Background="#F3F4F6" Padding="14,8" BorderBrush="#E5E7EB" BorderThickness="0,0,0,1"
                                Visibility="{Binding CurrentMessageDetails.HasAttachments, Converter={StaticResource BoolToVis}}">
                            <StackPanel>
                                <TextBlock Text="Allegati:" FontWeight="SemiBold" FontSize="11" Foreground="#4B5563" Margin="0,0,0,6"/>
                                <ItemsControl ItemsSource="{Binding CurrentMessageDetails.Attachments}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="White" BorderBrush="#D1D5DB" BorderThickness="1" CornerRadius="4" Padding="8,4" Margin="0,0,8,6">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="📎 " FontSize="11" VerticalAlignment="Center"/>
                                                    <TextBlock Text="{Binding FileName}" FontSize="12" FontWeight="Medium" Foreground="#1F2937" VerticalAlignment="Center"/>
                                                    <TextBlock Text="{Binding FormattedSize, StringFormat=' ({0})'}" FontSize="11" Foreground="#9CA3AF" VerticalAlignment="Center"/>
                                                    <Button Content="Apri" Margin="8,0,2,0" Padding="6,2" FontSize="10" Background="#EFF6FF" Foreground="#2563EB" BorderThickness="0" Cursor="Hand"
                                                            Command="{Binding DataContext.OpenAttachmentCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}"/>
                                                    <Button Content="Salva" Margin="2,0,0,0" Padding="6,2" FontSize="10" Background="#ECFDF5" Foreground="#059669" BorderThickness="0" Cursor="Hand"
                                                            Command="{Binding DataContext.SaveAttachmentCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}"/>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <!-- Visualizzatore Corpo Email (WebBrowser nativo) -->
                        <Grid Grid.Row="2">
                            <WebBrowser x:Name="EmailBrowser" Margin="4"/>
                        </Grid>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- 4. BOTTOM STATUS BAR -->
        <Border Grid.Row="4" Background="#F9FAFB" BorderBrush="#E5E7EB" BorderThickness="0,1,0,0" Padding="14,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Pronto" FontSize="11" Foreground="#6B7280"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <TextBlock Text="{Binding TotalMessagesCount, StringFormat='Totale messaggi: {0} '}" FontSize="11" Foreground="#4B5563" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding FormattedTotalSize, StringFormat='| Dimensione totale: {0}'}" FontSize="11" Foreground="#059669" FontWeight="Bold"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
