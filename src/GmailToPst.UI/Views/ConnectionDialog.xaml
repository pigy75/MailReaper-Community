<Window x:Class="GmailToPst.UI.Views.ConnectionDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:conv="clr-namespace:GmailToPst.UI.Converters"
        mc:Ignorable="d"
        Title="Configurazione Account Gmail / Microsoft 365 &amp; Backup" 
        Height="690" Width="660"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#F4F5F7">
    <Window.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis"/>
        <conv:BoolToVisibilityConverter x:Key="InverseBoolToVis" Invert="True"/>
        <conv:NullToVisibilityConverter x:Key="NullToVis"/>
        <Style TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="BorderBrush" Value="#D1D5DB"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Header -->
            <RowDefinition Height="Auto"/> <!-- Saved Profiles Card -->
            <RowDefinition Height="*"/>    <!-- Tabs -->
            <RowDefinition Height="Auto"/> <!-- Year Filter -->
            <RowDefinition Height="Auto"/> <!-- Bottom Buttons -->
        </Grid.RowDefinitions>

        <!-- 1. Intestazione -->
        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="Configurazione Connessione &amp; Filtro Anno" FontSize="18" FontWeight="SemiBold" Foreground="#111827"/>
            <TextBlock Text="Scegli un account salvato o inserisci i dati per effettuare il download mirato." FontSize="12" Foreground="#6B7280" Margin="0,3,0,0"/>
        </StackPanel>

        <!-- 2. Profili Salvati -->
        <Border Grid.Row="1" Background="White" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="👤 Account Salvati:" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center" Margin="0,0,12,0"/>
                <ComboBox Grid.Column="1" ItemsSource="{Binding SavedProfiles}" SelectedItem="{Binding SelectedProfile}" DisplayMemberPath="EmailAddress" Height="32" VerticalContentAlignment="Center"/>
                <Button Grid.Column="2" Content="Elimina" Width="70" Height="32" Margin="8,0,0,0" Background="#FEE2E2" Foreground="#DC2626" BorderThickness="0" Command="{Binding DeleteSelectedProfileCommand}" Cursor="Hand" ToolTip="Elimina profilo selezionato"/>
            </Grid>
        </Border>

        <!-- 3. Schede Autenticazione -->
        <TabControl Grid.Row="2" SelectedIndex="{Binding SelectedAuthTabIndex, Mode=TwoWay}" Background="White" BorderBrush="#E5E7EB" BorderThickness="1">
            
            <!-- TAB 0: IMAP (Password per le App) -->
            <TabItem Header="🔑 Google / Gmail (Password per le App)">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16">
                    <StackPanel>
                        <Border Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,12">
                            <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="#1E40AF">
                                <Bold>Metodo Consigliato e Immediato:</Bold> Inserisci il tuo indirizzo Gmail e una <Bold>Password per le App</Bold> (16 lettere generate su myaccount.google.com &gt; Sicurezza &gt; Verifica in 2 passaggi).
                            </TextBlock>
                        </Border>

                        <TextBlock Text="Indirizzo Email Google (Gmail o Workspace)" FontWeight="Medium" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding ImapEmail, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10"/>

                        <TextBlock Text="Password per le App (16 caratteri)" FontWeight="Medium" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding ImapAppPassword, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10"/>

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="100"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                <TextBlock Text="Server IMAP" FontWeight="Medium" Margin="0,0,0,4"/>
                                <TextBox Text="{Binding ImapHost, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Porta" FontWeight="Medium" Margin="0,0,0,4"/>
                                <TextBox Text="{Binding ImapPort, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                        </Grid>

                        <CheckBox Content="Salva questo account nei profili protetti per i prossimi backup" IsChecked="{Binding SaveProfile}" Margin="0,4,0,0" FontWeight="Medium"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- TAB 1: OAuth 2.0 -->
            <TabItem Header="🌐 Google OAuth 2.0 (Browser)">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16">
                    <StackPanel>
                        <Border Background="#FEF3C7" BorderBrush="#FDE68A" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,12">
                            <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="#92400E">
                                <Bold>Autenticazione OAuth 2.0:</Bold> Richiede un'app configurata su Google Cloud Console con Scope Gmail Readonly. Si aprirà il browser per confermare l'accesso.
                            </TextBlock>
                        </Border>

                        <TextBlock Text="Indirizzo Email (opzionale per pre-compilazione)" FontWeight="Medium" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding OauthEmail, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10"/>

                        <TextBlock Text="Google Client ID" FontWeight="Medium" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding OauthClientId, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10"/>

                        <TextBlock Text="Google Client Secret" FontWeight="Medium" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding OauthClientSecret, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10"/>

                        <CheckBox Content="Salva credenziali OAuth nei profili protetti" IsChecked="{Binding SaveProfile}" Margin="0,4,0,0" FontWeight="Medium"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- TAB 2: Google Workspace Admin (Delega di Dominio) -->
            <TabItem Header="🏢 Google Workspace (Dominio)">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16">
                    <StackPanel>
                        <Border Background="#F0FDF4" BorderBrush="#BBF7D0" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,12">
                            <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="#166534">
                                <Bold>Delega a livello di dominio (Google Workspace):</Bold> Permette all'Amministratore di recuperare in automatico tutte le caselle dell'azienda e scaricare i backup senza chiedere password ai singoli dipendenti.
                            </TextBlock>
                        </Border>

                        <TextBlock Text="Email Amministratore (Super Admin)" FontWeight="Medium" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding WorkspaceAdminEmail, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10"/>

                        <TextBlock Text="File Chiave del Service Account (.json)" FontWeight="Medium" Margin="0,0,0,4"/>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Text="{Binding WorkspaceKeyFilePath, UpdateSourceTrigger=PropertyChanged}" Padding="6,4" FontSize="12" VerticalContentAlignment="Center"/>
                            <Button Grid.Column="1" Content="Sfoglia..." Width="80" Height="30" Margin="8,0,0,0" Command="{Binding BrowseWorkspaceKeyFileCommand}" Cursor="Hand"/>
                        </Grid>

                        <Button Content="{Binding DiscoverButtonText}" Background="#0284C7" Foreground="White" FontWeight="SemiBold" Height="34" BorderThickness="0" Margin="0,0,0,10" Command="{Binding DiscoverWorkspaceUsersCommand}" IsEnabled="{Binding IsNotDiscoveringUsers}" Cursor="Hand"/>

                        <Border Background="#F9FAFB" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="6" Padding="8" Margin="0,0,0,10">
                            <TextBlock Text="{Binding WorkspaceStatusText}" FontSize="12" Foreground="#1F2937" FontWeight="Medium"/>
                        </Border>

                        <!-- Selettore Utente Trovato -->
                        <StackPanel Visibility="{Binding HasDiscoveredUsers, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="👤 Seleziona Casella Postale da Scaricare:" FontWeight="Bold" FontSize="12" Foreground="#111827" Margin="0,0,0,4"/>
                            <ComboBox ItemsSource="{Binding WorkspaceUsers}" SelectedItem="{Binding SelectedWorkspaceUser}" DisplayMemberPath="DisplayText" Height="32" VerticalContentAlignment="Center" Margin="0,0,0,10"/>
                        </StackPanel>

                        <CheckBox Content="Salva credenziali Service Account nei profili protetti" IsChecked="{Binding SaveProfile}" Margin="0,4,0,0" FontWeight="Medium"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- TAB 3: Microsoft 365 (Singolo & Dominio Admin) -->
            <TabItem Header="🟦 Microsoft 365">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16">
                    <StackPanel>
                        <Border Background="#F0F9FF" BorderBrush="#BAE6FD" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,12">
                            <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="#0369A1">
                                <Bold>Microsoft 365 / Entra ID (Graph API):</Bold> Backup ad alta efficienza per Microsoft 365. Supporta sia il download di una singola casella sia la gestione centralizzata di tutte le caselle del dominio aziendale (Microsoft 365 Tenant Admin).
                            </TextBlock>
                        </Border>

                        <!-- Scelta modalità: Tenant Admin vs Singolo Account -->
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <RadioButton Grid.Column="0" GroupName="M365Mode" Content="🏢 Dominio / Tenant (Admin)" IsChecked="{Binding M365IsAdminMode, Mode=TwoWay}" FontWeight="SemiBold"/>
                            <RadioButton Grid.Column="1" GroupName="M365Mode" Content="👤 Account Singolo" IsChecked="{Binding M365IsSingleAccountMode, Mode=TwoWay}" FontWeight="SemiBold"/>
                        </Grid>

                        <TextBlock Text="Tenant ID / Directory ID (Azure Entra ID)" FontWeight="Medium" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding M365TenantId, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10"/>

                        <TextBlock Text="Client ID / Application ID (Registrazione App)" FontWeight="Medium" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding M365ClientId, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10"/>

                        <TextBlock Text="Client Secret (Valore del Segreto)" FontWeight="Medium" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding M365ClientSecret, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10"/>

                        <!-- Sezione modalità Admin: Discovery Utenti -->
                        <StackPanel Visibility="{Binding M365IsAdminMode, Converter={StaticResource BoolToVis}}">
                            <Button Content="{Binding M365DiscoverButtonText}" Background="#0284C7" Foreground="White" FontWeight="SemiBold" Height="34" BorderThickness="0" Margin="0,0,0,10" Command="{Binding DiscoverM365UsersCommand}" IsEnabled="{Binding M365IsNotDiscoveringUsers}" Cursor="Hand"/>

                            <Border Background="#F9FAFB" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="6" Padding="8" Margin="0,0,0,10">
                                <TextBlock Text="{Binding M365StatusText}" FontSize="12" Foreground="#1F2937" FontWeight="Medium"/>
                            </Border>

                            <StackPanel Visibility="{Binding M365HasDiscoveredUsers, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="👤 Seleziona Casella Postale da Scaricare:" FontWeight="Bold" FontSize="12" Foreground="#111827" Margin="0,0,0,4"/>
                                <ComboBox ItemsSource="{Binding M365Users}" SelectedItem="{Binding SelectedM365User}" DisplayMemberPath="DisplayText" Height="32" VerticalContentAlignment="Center" Margin="0,0,0,10"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- Sezione modalità Account Singolo -->
                        <StackPanel Visibility="{Binding M365IsSingleAccountMode, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="Indirizzo Email Casella da Scaricare (UPN)" FontWeight="Medium" Margin="0,0,0,4"/>
                            <TextBox Text="{Binding M365UserEmail, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10"/>
                        </StackPanel>

                        <CheckBox Content="Salva credenziali Microsoft 365 nei profili protetti" IsChecked="{Binding SaveProfile}" Margin="0,4,0,0" FontWeight="Medium"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <!-- 4. FILTRO TEMPORALE SORGENTE (ANNO) -->
        <Border Grid.Row="3" Background="White" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,12,0,12">
            <StackPanel>
                <TextBlock Text="🎯 Filtro Temporale alla Sorgente (Download Selettivo)" FontWeight="SemiBold" FontSize="13" Foreground="#111827" Margin="0,0,0,8"/>
                
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="140"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <RadioButton Grid.Column="0" GroupName="TimeFilterOption" Content="Filtra per Anno:" IsChecked="{Binding FilterByYear, Mode=TwoWay}" FontWeight="Medium" VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <ComboBox Grid.Column="1" ItemsSource="{Binding AvailableYears}" SelectedItem="{Binding SelectedYear}" IsEnabled="{Binding FilterByYear}" Height="32" VerticalContentAlignment="Center"/>
                    <TextBlock Grid.Column="2" Text="💡 Scarica solo le email dell'anno selezionato" VerticalAlignment="Center" Margin="12,0,0,0" Foreground="#059669" FontWeight="Medium" FontSize="12"/>
                </Grid>

                <Grid Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <RadioButton Grid.Column="0" GroupName="TimeFilterOption" Content="Scarica tutta la posta" IsChecked="{Binding DownloadAll, Mode=TwoWay}" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Text="(Nessun filtro temporale)" Foreground="#9CA3AF" FontSize="11" Margin="10,0,0,0" VerticalAlignment="Center"/>
                </Grid>

                <Separator Margin="0,10,0,8" Background="#E5E7EB"/>

                <TextBlock Text="📂 Cartella di Salvataggio Archivio Locale:" FontWeight="Medium" FontSize="12" Foreground="#374151" Margin="0,0,0,4"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox Text="{Binding ArchiveBasePath, UpdateSourceTrigger=PropertyChanged}" Padding="6,4" FontSize="11" VerticalContentAlignment="Center"/>
                    <Button Grid.Column="1" Content="Sfoglia..." Width="70" Height="28" Margin="8,0,0,0" Command="{Binding BrowseArchiveFolderCommand}" Cursor="Hand"/>
                </Grid>
            </StackPanel>
        </Border>

        <!-- 5. Pulsanti di Azione -->
        <Grid Grid.Row="4">
            <Button HorizontalAlignment="Left" Content="{Binding AnalyzeButtonText}" Height="36" Padding="14,0" Background="#F0F9FF" BorderBrush="#BAE6FD" Foreground="#0284C7" FontWeight="SemiBold" Command="{Binding AnalyzeMailboxCommand}" Cursor="Hand" ToolTip="Analizza la casella online e visualizza quanti messaggi ci sono per ciascun anno prima di scaricare"/>
            
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Annulla" Width="90" Height="36" Margin="0,0,10,0" Background="#F3F4F6" BorderBrush="#D1D5DB" Click="Cancel_Click" Cursor="Hand"/>
                <Button Content="🚀 Avvia Download" Width="190" Height="36" Background="#2563EB" Foreground="White" FontWeight="SemiBold" BorderThickness="0" Command="{Binding StartBackupCommand}" Cursor="Hand"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
