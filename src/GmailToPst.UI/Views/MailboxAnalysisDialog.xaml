<Window x:Class="GmailToPst.UI.Views.MailboxAnalysisDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:conv="clr-namespace:GmailToPst.UI.Converters"
        mc:Ignorable="d"
        Title="📊 Analisi Volumetrica Casella per Anno" 
        Height="540" Width="680"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        Background="#F8FAFC">
    <Window.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis"/>
        <conv:BoolToVisibilityConverter x:Key="InverseBoolToVis" Invert="True"/>
        <Style TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI"/>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Header -->
            <RowDefinition Height="Auto"/> <!-- Summary Cards -->
            <RowDefinition Height="*"/>    <!-- DataGrid -->
            <RowDefinition Height="Auto"/> <!-- Bottom Actions -->
        </Grid.RowDefinitions>

        <!-- 1. Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <TextBlock Text="📊 Analisi Volumetrica &amp; Contenuto per Anno" FontSize="18" FontWeight="SemiBold" Foreground="#0F172A"/>
            <TextBlock Text="{Binding Email, StringFormat='Riepilogo dettagliato della casella: {0}'}" FontSize="13" Foreground="#475569" Margin="0,2,0,0"/>
        </StackPanel>

        <!-- 2. Summary Cards -->
        <Grid Grid.Row="1" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,6,0">
                <StackPanel>
                    <TextBlock Text="Totale Messaggi Online" FontSize="11" Foreground="#64748B" FontWeight="Medium"/>
                    <TextBlock Text="{Binding TotalServerMessages, StringFormat='{}{0:N0}'}" FontSize="20" FontWeight="Bold" Foreground="#0284C7" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="1" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="12" Margin="3,0,3,0">
                <StackPanel>
                    <TextBlock Text="Cartelle &amp; Etichette" FontSize="11" Foreground="#64748B" FontWeight="Medium"/>
                    <TextBlock Text="{Binding TotalFoldersCount, StringFormat='{}{0:N0}'}" FontSize="20" FontWeight="Bold" Foreground="#6366F1" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="2" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="12" Margin="6,0,0,0">
                <StackPanel>
                    <TextBlock Text="Già Scaricati in Locale" FontSize="11" Foreground="#64748B" FontWeight="Medium"/>
                    <TextBlock Text="{Binding TotalLocalMessages, StringFormat='{}{0:N0}'}" FontSize="20" FontWeight="Bold" Foreground="#10B981" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- 3. Years Table -->
        <Border Grid.Row="2" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="0">
            <DataGrid ItemsSource="{Binding Years}" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" IsReadOnly="True" HeadersVisibility="Column" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#F1F5F9" BorderThickness="0" Background="White" RowHeight="38" SelectionMode="Single">
                <DataGrid.Columns>
                    <!-- Anno -->
                    <DataGridTextColumn Header="Anno" Binding="{Binding Year}" Width="80" FontWeight="SemiBold" FontSize="13"/>
                    
                    <!-- Messaggi Online -->
                    <DataGridTextColumn Header="Email Online" Binding="{Binding ServerCount, StringFormat='{}{0:N0}'}" Width="120" FontSize="13"/>
                    
                    <!-- Già Scaricati -->
                    <DataGridTextColumn Header="Archiviati in Locale" Binding="{Binding LocalCount, StringFormat='{}{0:N0}'}" Width="140" FontSize="13"/>

                    <!-- Stato -->
                    <DataGridTemplateColumn Header="Stato" Width="140">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding StatusBadge}" FontWeight="Medium" VerticalAlignment="Center" Margin="8,0" Foreground="#334155"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Azione -->
                    <DataGridTemplateColumn Header="Azione" Width="*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="⬇️ Scarica questo Anno" Height="26" Padding="10,0" Margin="4" Background="#F1F5F9" BorderBrush="#CBD5E1" Foreground="#0F172A" FontWeight="Medium" FontSize="11" Cursor="Hand" Command="{Binding DataContext.DownloadYearCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding Year}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- 4. Bottom Actions -->
        <Grid Grid.Row="3" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" Text="{Binding StatusText}" VerticalAlignment="Center" Foreground="#64748B" FontSize="12"/>

            <Button Grid.Column="1" Content="Chiudi" Width="90" Height="34" Margin="0,0,10,0" Background="#F1F5F9" BorderBrush="#CBD5E1" Click="Close_Click" Cursor="Hand"/>
            
            <Button Grid.Column="2" Content="🚀 Scarica Tutta la Posta (Tutti gli Anni)" Width="270" Height="34" Background="#2563EB" Foreground="White" FontWeight="SemiBold" BorderThickness="0" Command="{Binding DownloadAllCommand}" Cursor="Hand"/>
        </Grid>
    </Grid>
</Window>
