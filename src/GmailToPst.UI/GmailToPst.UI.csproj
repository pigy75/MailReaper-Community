<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\GmailToPst.Core\GmailToPst.Core.csproj" />
    <ProjectReference Include="..\GmailToPst.Providers\GmailToPst.Providers.csproj" />
    <ProjectReference Include="..\GmailToPst.Storage\GmailToPst.Storage.csproj" />
    <ProjectReference Include="..\GmailToPst.Exporters\GmailToPst.Exporters.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4191.47" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>assets\mailreaper.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="assets\mailreaper.png" />
    <Resource Include="assets\mailreaper.ico" />
    <Resource Include="assets\app.png" />
    <Resource Include="assets\app.ico" />
  </ItemGroup>

</Project>
